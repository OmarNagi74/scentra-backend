# Backend environment variables
# Copy this file to .env and replace placeholders with real values.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:5091@localhost:5432/scentra?schema=public"

# API server port
PORT=4000

# JWT secret used for auth token signing
JWT_SECRET="replace_with_a_long_random_secret"